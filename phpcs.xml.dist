<?xml version="1.0"?>
<ruleset name="NExT Query Loop Link Target">
    <description>Custom ruleset for NExT Query Loop Link Target</description>

    <!-- 対象ファイル -->
    <file>./nqllt.php</file>

    <!-- 除外 -->
    <exclude-pattern>./vendor/*</exclude-pattern>
    <exclude-pattern>./node_modules/*</exclude-pattern>
    <exclude-pattern>./tests/*</exclude-pattern>

    <!-- WordPress Coding Standards -->
    <rule ref="WordPress"/>

    <!-- PHP互換性チェック -->
    <rule ref="PHPCompatibilityWP"/>

    <!-- PHP バージョン -->
    <config name="testVersion" value="7.4-"/>

    <!-- テキストドメイン -->
    <config name="text_domain" value="nqllt"/>

    <!-- プレフィックス -->
    <config name="prefixes" value="nqllt"/>
    <config name="minimum_wp_version" value="6.1"/>
</ruleset>
